diff --git a/components/kaos/Kconfig b/components/kaos/Kconfig
index 718640c..5a6a792 100644
--- a/components/kaos/Kconfig
+++ b/components/kaos/Kconfig
@@ -226,6 +226,20 @@ menu "kodeOS active objects"
 
                 On in kodeOS, off in an app.
 
+        config KODEOS_FINDHUB
+            bool "Find Hub beacon (Google's Find Hub network)"
+            depends on KODEOS_BLE
+            default y if KODEOS_BOOT_ROLE_OS
+            help
+                Lets the board send a Find Hub Network advert between the
+                console's own, so Android phones nearby report where it is to
+                its owner's Google account, end-to-end encrypted. Nothing is
+                sent until the owner sets a key with `findhub_set` (see
+                kode-findhub/README.md). Costs about 30 ms of radio every
+                1.7-1.95 s while the BLE host is up.
+
+                On in kodeOS, off in an app.
+
         config KODEOS_BLE_DEFAULT_ON
             bool "BLE on when the store has never been written"
             depends on KODEOS_BLE
